# Copy to .env; the worker, web console and TUI load it.

# A Hatchet API token for your tenant (Hatchet dashboard: Settings > API Tokens).
HATCHET_CLIENT_TOKEN=
# For a self-hosted engine without TLS, for example:
# HATCHET_CLIENT_HOST_PORT=localhost:7070
# HATCHET_CLIENT_TLS_STRATEGY=none

# The worker calls Claude with this key.
ANTHROPIC_API_KEY=
# RACE_MODEL=claude-opus-5-5

# Optional overrides
# RACE_IMAGE=pgrace-seed:shop       # the sandbox image with the seeded database
# PORT=3335                         # the web console's port
# HATCHET_DASHBOARD_URL=            # dashboard links; defaults to the token's server URL
# HATCHET_TENANT_ID=                # dashboard links; defaults to the token's tenant
